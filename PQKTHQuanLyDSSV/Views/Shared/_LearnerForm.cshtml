@model PQKTHQuanLyDSSV.Models.Learner
@{
    var isEdit = ViewData["Title"]?.ToString() == "Edit";
}
<div class="container mt-3">
    <h2>@(isEdit ? "Sửa người học" : "Thêm người học")</h2>
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @if (isEdit) { <input type="hidden" asp-for="LearnerID" /> }
        <div class="mb-3">
            <label asp-for="FirstMidName" class="form-label">Tên</label>
            <input asp-for="FirstMidName" class="form-control" />
            <span asp-validation-for="FirstMidName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="LastName" class="form-label">Họ</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MajorID" class="form-label">Ngành</label>
            <select asp-for="MajorID" asp-items="ViewBag.MajorID" class="form-select">
                <option value="">-- Chọn ngành --</option>
            </select>
            <span asp-validation-for="MajorID" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="EnrollmentDate" class="form-label">Ngày nhập học</label>
            <input asp-for="EnrollmentDate" type="date" class="form-control" />
            <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>