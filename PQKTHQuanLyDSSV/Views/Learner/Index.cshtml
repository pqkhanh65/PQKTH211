@model IEnumerable<PQKTHQuanLyDSSV.Models.Learner>
@{
    ViewData["Title"] = "Learner List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid mt-3">
    <h1>Learner List</h1>
    @await Component.InvokeAsync("Major")
    <div class="row mb-3">
        <div class="col-md-5">
            <div class="input-group">
                <input id="keyword" class="form-control" type="text" placeholder="Search learner" />
                <button id="btnSearch" class="btn btn-primary" type="button">Tìm kiếm</button>
                <button id="btnAll" class="btn btn-outline-secondary" type="button">Tất cả</button>
            </div>
        </div>
    </div>
    <div id="content">@await Html.PartialAsync("LearnerTable", Model)</div>
    <a asp-action="Create" class="btn btn-primary mt-2">Create New Student</a>
</div>
@section Scripts {
<script>
    let selectedMajor = null;
    let currentKeyword = "";
    function loadLearners(page) {
        $.ajax({
            url: '@Url.Action("LearnerFilter", "Learner")',
            type: 'GET',
            data: { mid: selectedMajor, keyword: currentKeyword, pageIndex: page || 1 },
            success: function (response) { $("#content").html(response); },
            error: function () { alert("Không thể tải dữ liệu."); }
        });
    }
    $("#majorMenu").on("click", ".major-link", function (e) {
        e.preventDefault();
        selectedMajor = $(this).closest("li").attr("id");
        $("#majorMenu .nav-link").removeClass("active");
        $(this).addClass("active");
        currentKeyword = "";
        $("#keyword").val("");
        loadLearners(1);
    });
    $("#btnSearch").on("click", function () {
        currentKeyword = $("#keyword").val().trim();
        loadLearners(1);
    });
    $("#keyword").on("keydown", function (e) {
        if (e.key === "Enter") { e.preventDefault(); $("#btnSearch").click(); }
    });
    $("#btnAll").on("click", function () {
        selectedMajor = null;
        currentKeyword = "";
        $("#keyword").val("");
        $("#majorMenu .nav-link").removeClass("active");
        loadLearners(1);
    });
    $("#content").on("click", ".page-item[data-page]", function (e) {
        e.preventDefault();
        loadLearners($(this).data("page"));
    });
</script>
}